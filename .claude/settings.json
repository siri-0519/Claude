{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "promptSuggestionEnabled": false,
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "timeout": 60,
        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook.py session_start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "timeout": 20,
        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook.py user_prompt_submit" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "timeout": 20,
          "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook.py pre_tool_use" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [ { "type": "command", "timeout": 30,
          "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook.py post_tool_use" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 360,
        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook.py stop" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ops/bin/ops:*)",
      "Bash(python3 ops/bin/ops:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
