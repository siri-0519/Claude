#!/usr/bin/env python3
"""ops — 이 레포의 명령 하나. 다른 곳에 스크립트를 만들지 않는다.

  ops build [--검사]                 생성 파일(STATUS.md · README.md · CLAUDE.md 목차 블록 · worklog.md · 어긋남 목록)을 다시 만든다 / 원본과 다른 것만 짚는다
  ops check [--커밋]                 기계 규칙에 지금 걸리는 것 / 스테이지된 것만 (pre-commit)
  ops ack <파생물> [--그대로 "이유"]  파생물의 출처 해시를 다시 고정한다 (어긋남 목록에서 지운다)
  ops 출처 <파생물> <출처>...         파생물에 사이드카(.meta.yml)를 만든다
  ops 어긋남                         어긋남 목록을 다시 만들고 보인다
  ops log add --종류 K --제목 T [--본문 B] [--참조 P...] / ops log list [-n N]
  ops 토큰                            훅이 문맥에 넣거나 막으며 보낸 글의 크기(날 · 자리별)와 판정을 시킨 횟수
  ops 횟수 [--본인 <규칙> [--어디 W]] 규칙별 위반 횟수를 주 단위로 / 본인이 잡은 것을 적는다 / --합치기: 아직 안 합친 줄을 memory/횟수.jsonl 로
  ops 판정 [--문서] [--글 파일]        판정 모델을 손으로 돌린다 (문서: 스테이지된 새 줄 · 글: 파일 하나)
  ops rules                          기계 규칙 대장과 판단 규칙 파일
  ops worklog                        worklog.md 만 다시 만든다
  ops hook <자리>                    훅 하나를 돌린다 (.claude/hooks/hook.py 가 부른다)
  ops hooks [--설치] [--push]        훅이 도는지 / git 훅을 건다 / pre-push 검사
  ops hooks --route <자리> --위 <디렉터리>   레포 여럿 위에서 연 세션의 라우터 (~/.claude/route.sh)
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import 공통  # noqa: E402


def 뿌리() -> Path:
    return 공통.뿌리찾기(Path(os.environ.get("CLAUDE_PROJECT_DIR") or Path(__file__).resolve().parents[2]))


def cmd_build(a) -> int:
    import 생성
    r = 뿌리(); c = 공통.설정(r)
    if a.검사:
        문제 = 생성.다른것(r, c)
        print("\n".join(문제) if 문제 else "생성 파일이 전부 원본과 같다")
        return 1 if 문제 else 0
    한것 = 생성.만들기(r, c)
    print("다시 만들었다: " + ", ".join(한것) if 한것 else "바뀐 것이 없다")
    return 0


def cmd_check(a) -> int:
    import 기계
    r = 뿌리(); c = 공통.설정(r)
    if a.커밋:
        n = 공통.횟수합치기(r)          # 답 끝 검사가 적어 둔 기록(위반 횟수 · 판정 · 문맥 크기)을 이 커밋에 얹는다 (한 줄짜리 커밋을 안 만든다)
        if n:
            공통.git(r, "add", *[파일 for 파일, _ in 공통.기록들.values() if (r / 파일).is_file()])
    문제 = 기계.커밋검사(r, c) if a.커밋 else 기계.지금검사(r, c)
    if a.커밋 and not 문제:
        문제 += 문서판정(r, c)
    if 문제:
        머리 = 공통.보낸이 + "커밋 전에 걸렸다. 항마다 적힌 대로 고치고 다시 커밋한다. 누구의 말인지 모르면 [제안] 을 붙이고 사용자에게 되묻지 않는다:" if a.커밋 else "지금 걸리는 것 (항마다 적힌 대로 고친다):"
        print(머리 + "\n" + "\n".join("- " + x for x in 문제))
        return 1
    print("걸리는 것이 없다")
    return 0


def 문서판정(r: Path, c: dict) -> list[str]:
    """커밋 직전 — 스테이지된 주제 파일의 새 줄을 「고칠 때」 규칙으로 판정한다."""
    import 판정, 표시
    if os.environ.get("OPS_JUDGE") == "off" or c["판정"].get("끄기"):
        return []
    줄들 = []
    옛 = 공통.옛줄전부(r, c)
    for p in 공통.주제파일들(r, c):
        rr = 공통.rel(r, p)
        if not 공통.git(r, "diff", "--cached", "--name-only", "--", rr):
            continue
        글 = 공통.git(r, "show", f":{rr}").split("\n")
        번호 = 표시.새줄들(r, rr, 스테이지=True) if 공통.git(r, "ls-files", "--error-unmatch", "--", rr) else set(range(1, len(글) + 1))
        for i in sorted(번호):
            if 0 < i <= len(글) and 글[i - 1].strip() and 글[i - 1].strip() not in 옛:
                줄들.append(f"{rr}:{i}: {글[i - 1]}")
    if not 줄들:
        return []
    규칙 = 판정.규칙글(r, "고칠 때")
    if not 규칙:
        return []
    # 한 번에 넘기면 줄이 많을 때 시간을 넘긴다 (2026-09-14 broadcast 3단계: 새 줄 200여 개가 180초를 넘겨 기계 규칙만 봤다).
    # 그래서 묶음으로 나눠 부른다. 한 묶음이라도 못 보면 그 묶음의 줄을 이름으로 알린다.
    묶음크기 = int(c["판정"].get("묶음") or 40)
    어긴것: list[dict] = []
    for k in range(0, len(줄들), 묶음크기):
        묶음 = 줄들[k:k + 묶음크기]
        걸린, 오류 = 판정.부르기(r, 판정.물음("", "\n".join(묶음), 규칙, [], [], "문서"), c)
        if 오류:
            print(f"(문서 판정을 못 했다: {오류} — {묶음[0].split(': ')[0]} 부터 {len(묶음)}줄은 기계 규칙만 봤다)", file=sys.stderr)
            continue
        어긴것 += 걸린
    for x in 어긴것:
        공통.횟수추가(r, "판정", x["규칙"], x["문장"][:80])
    전문 = 판정.규칙전문들(r)
    return [f"판정(다른 모델이 판단 규칙으로 본 것) — 걸린 줄: {x['문장']}" + (f" — {x['이유']}" if x["이유"] else "")
            + f". 그 줄을 고치고 다시 커밋한다. 규칙 {x['규칙']}: {전문.get(x['규칙'], '')}" for x in 어긴것]


def cmd_ack(a) -> int:
    import 어긋남
    print(어긋남.ack(뿌리(), a.파생물, a.그대로))
    return 0


def cmd_출처(a) -> int:
    import 어긋남
    print(어긋남.새로만들기(뿌리(), a.파생물, a.출처))
    return 0


def cmd_어긋남(a) -> int:
    import 어긋남
    r = 뿌리(); c = 공통.설정(r)
    어긋남.만들기(r, c)
    print((r / 어긋남.목록파일).read_text(encoding="utf-8"))
    return 0


def cmd_log(a) -> int:
    r = 뿌리()
    if a.what == "add":
        p = 공통.로그추가(r, a.종류, a.제목, a.본문 or "", a.참조 or None)
        print(f"{공통.rel(r, p)} 에 적었다")
        return 0
    for e in 공통.로그읽기(r, a.n):
        때 = str(e.get("때") or e.get("ts") or "")[:16]
        print(f"{때} {e.get('종류') or e.get('kind','')}: {e.get('제목') or e.get('title','')}")
    return 0


def cmd_토큰(a) -> int:
    """훅이 문맥에 넣거나 막으며 보낸 글의 크기 — 날 · 자리별 합과 횟수. 판정을 시킨 횟수도 같이 (어긴 횟수의 분모)."""
    r = 뿌리()
    from collections import defaultdict
    합: dict = defaultdict(lambda: [0, 0])
    for d in 공통.기록읽기(r, "문맥"):
        k = (str(d.get("때", ""))[:10], f"{d.get('자리','?')}·{d.get('어떻게','?')}")
        합[k][0] += int(d.get("바이트") or 0); 합[k][1] += 1
    if not 합:
        print("적힌 것이 없다 — 훅이 글을 넣을 때마다 .meta/문맥.new.jsonl 에 쌓이고 커밋 직전에 memory/문맥.jsonl 로 합쳐진다")
    else:
        print("| 날 | 자리·어떻게 | 바이트 | 번 |\n|---|---|---|---|")
        for (날, 자리), (b, n) in sorted(합.items(), reverse=True)[:60]:
            print(f"| {날} | {자리} | {b} | {n} |")
    판정들 = 공통.기록읽기(r, "판정")
    if 판정들:
        날별: dict = defaultdict(lambda: [0, 0])
        for d in 판정들:
            k = str(d.get("때", ""))[:10]; 날별[k][0] += 1; 날별[k][1] += 1 if int(d.get("어긴") or 0) else 0
        print("\n판정을 시킨 횟수(날 · 시킨 번 · 어긴 것이 있던 번):")
        for 날, (n, m) in sorted(날별.items(), reverse=True)[:30]:
            print(f"- {날}: {n}번 시켜 {m}번 걸렸다")
    return 0


def cmd_횟수(a) -> int:
    if a.합치기:
        r = 뿌리(); n = 공통.횟수합치기(r)
        print(f"아직 안 합친 위반 횟수 {n}줄을 {공통.횟수파일} 로 합쳤다" if n else "합칠 것이 없다")
        return 0
    r = 뿌리()
    if a.본인:
        공통.횟수추가(r, "본인", a.본인, a.어디 or "")
        print(f"적었다: 본인 · {a.본인}")
        return 0
    항 = 공통.횟수요약(r)
    if not 항:
        print("적힌 횟수가 없다")
        return 0
    print("| 주 | 누가·규칙 | 횟수 |\n|---|---|---|")
    for 주, k, n in 항:
        print(f"| {주} | {k} | {n} |")
    return 0


def cmd_판정(a) -> int:
    import 판정
    r = 뿌리(); c = 공통.설정(r)
    if a.문서:
        문제 = 문서판정(r, c)
        print("\n".join(문제) if 문제 else "걸린 것이 없다")
        return 1 if 문제 else 0
    if a.글:
        import 낱말
        답 = Path(a.글).read_text(encoding="utf-8")
        후보 = 낱말.후보(답, 낱말.아는말(r, c, [], set()))     # 대화가 없으니 사용자의 말 없이 레포 문서와 허용 목록만으로 거른다
        어긴것, 오류 = 판정.부르기(r, 판정.물음("(손으로 돌린 판정 — 요청은 없다. 요청이 없다는 것으로는 판정하지 않는다)", 답, 판정.규칙글(r, "답할 때"), [], 후보[:60], "답"), c)
        if 오류:
            print(오류); return 1
        print(판정.되돌리는말(어긴것, r) if 어긴것 else "걸린 것이 없다")
        return 1 if 어긴것 else 0
    print("--문서 또는 --글 <파일> 을 준다")
    return 1


def cmd_rules(a) -> int:
    import 기계
    r = 뿌리()
    print("기계 규칙 (ops/rules/기계.yml)\n")
    print(기계.보이기(r))
    문제 = 기계.대장검사(r)
    if 문제:
        print("\n대장에 빠진 것:\n" + "\n".join("- " + x for x in 문제))
    print("\n판단 규칙은 ops/rules/판단.md 에 있다. 「고칠 때」는 Edit · Write 직전에, 「답할 때」는 답 끝의 판정에 들어간다.")
    return 0


def cmd_worklog(a) -> int:
    import 작업로그
    n = 작업로그.만들기(뿌리())
    print(f"worklog.md 를 다시 만들었다 ({n})" if n else "worklog.md 가 그대로다")
    return 0


def cmd_hook(a) -> int:
    import 훅
    return 훅.돌리기(a.자리, 뿌리())


def cmd_hooks(a) -> int:
    import 훅
    if a.route:
        return 훅.라우트(_자리이름(a.route), Path(a.위 or os.getcwd()))
    r = 뿌리()
    if a.push:
        return push검사(r)
    if a.설치:
        공통.git(r, "config", "core.hooksPath", "ops/hooks")
        for h in ("pre-commit", "pre-push"):
            (r / "ops/hooks" / h).chmod(0o755)
        print("git 훅을 걸었다: core.hooksPath = ops/hooks")
    hp = 공통.git(r, "config", "core.hooksPath")
    print(f"git 훅: {'돈다 (core.hooksPath = ops/hooks)' if hp == 'ops/hooks' else '안 돈다 — ops hooks --설치'}")
    s = r / ".claude/settings.json"
    print(f"세션 훅: {'settings.json 이 있다' if s.is_file() else '.claude/settings.json 이 없다'} — 세션을 이 레포에서 열어야 돈다. "
          "레포 여럿 위에서 열었으면 ~/.claude/route.sh 가 `ops hooks --route` 로 넘긴다")
    return 0


def _자리이름(x: str) -> str:
    return {"SessionStart": "session_start", "UserPromptSubmit": "user_prompt_submit", "PreToolUse": "pre_tool_use",
            "PostToolUse": "post_tool_use", "Stop": "stop"}.get(x, x)


def push검사(r: Path) -> int:
    """pre-push — stdin 의 <local ref> <local sha> <remote ref> <remote sha> 줄에서 삭제와 비-fast-forward 를 막는다."""
    막힘 = []
    for ln in sys.stdin.read().splitlines():
        부분 = ln.split()
        if len(부분) != 4:
            continue
        lref, lsha, rref, rsha = 부분
        if rref == "refs/heads/main":
            # 세션은 main 에 직접 push 하지 않는다 (2026-09-16). 세션 브랜치로 push 하면 sync-main 워크플로가 main 에 넣고,
            # 검사 · 훅 · 규칙 · 설정을 바꾼 것이면 PR 로 잡아 둬 사용자가 웹에서 본다 — 직접 push 는 그 잡아 두기를 건너뛴다.
            막힘.append(f"{rref} 에 직접 push 하는 것이다. 세션 브랜치(claude/**)로 push 하면 sync-main 워크플로가 main 에 넣거나 PR 로 잡아 둔다")
        elif set(lsha) == {"0"}:
            막힘.append(f"{rref} 를 지우는 push 다. 원격 브랜치를 지우는 것은 사람이 GitHub 에서 한다. 사용자에게 그렇게 알린다")
        elif set(rsha) != {"0"}:
            import subprocess
            x = subprocess.run(["git", "-C", str(r), "merge-base", "--is-ancestor", rsha, lsha], capture_output=True)
            if x.returncode == 1:
                막힘.append(f"{rref} 의 이력을 다시 쓰는 push 다. 원격의 커밋 {rsha[:7]} 이 보내려는 {lsha[:7]} 에 들어 있지 않아서 원격 커밋이 사라진다. "
                            "먼저 `git pull --no-rebase` 로 원격을 합친 뒤 보통 push 를 한다")
    if 막힘:
        print(공통.보낸이 + "push 를 막았다. 이 push 는 포기한다:\n" + "\n".join("- " + x for x in 막힘), file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="ops", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd")
    x = sp.add_parser("build"); x.add_argument("--검사", action="store_true"); x.set_defaults(f=cmd_build)
    x = sp.add_parser("check"); x.add_argument("--커밋", action="store_true"); x.set_defaults(f=cmd_check)
    x = sp.add_parser("ack"); x.add_argument("파생물"); x.add_argument("--그대로", default=None); x.set_defaults(f=cmd_ack)
    x = sp.add_parser("출처"); x.add_argument("파생물"); x.add_argument("출처", nargs="+"); x.set_defaults(f=cmd_출처)
    x = sp.add_parser("어긋남"); x.set_defaults(f=cmd_어긋남)
    x = sp.add_parser("log"); x.add_argument("what", choices=["add", "list"]); x.add_argument("--종류", default="work")
    x.add_argument("--제목", default=""); x.add_argument("--본문", default=""); x.add_argument("--참조", nargs="*")
    x.add_argument("-n", type=int, default=20); x.set_defaults(f=cmd_log)
    x = sp.add_parser("토큰"); x.set_defaults(f=cmd_토큰)
    x = sp.add_parser("횟수"); x.add_argument("--본인", default=None); x.add_argument("--어디", default=""); x.add_argument("--합치기", action="store_true"); x.set_defaults(f=cmd_횟수)
    x = sp.add_parser("판정"); x.add_argument("--문서", action="store_true"); x.add_argument("--글", default=None); x.set_defaults(f=cmd_판정)
    x = sp.add_parser("rules"); x.set_defaults(f=cmd_rules)
    x = sp.add_parser("worklog"); x.set_defaults(f=cmd_worklog)
    x = sp.add_parser("hook"); x.add_argument("자리", choices=["session_start", "user_prompt_submit", "pre_tool_use", "post_tool_use", "stop"]); x.set_defaults(f=cmd_hook)
    x = sp.add_parser("hooks"); x.add_argument("--설치", action="store_true"); x.add_argument("--push", action="store_true")
    x.add_argument("--route", default=None); x.add_argument("--위", default=None); x.set_defaults(f=cmd_hooks)
    a = ap.parse_args(argv)
    if not a.cmd:
        ap.print_help(); return 0
    if a.cmd == "log" and a.what == "add" and not a.제목:
        print("--제목 이 필요하다"); return 1
    return a.f(a)


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # `ops rules | head` 가 되게
    sys.exit(main(sys.argv[1:]))
