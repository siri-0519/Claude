#!/usr/bin/env python3
"""ops — the only tool you need in this repo.

  ops ctx [card|log]      what happened / where things stand
  ops find                locate artifacts without reading them
  ops new / ingest        add data WITH its label and provenance
  ops link                the derivation graph: why / impact / check / ack
  ops log                 append to the machine log (digest regenerates itself)
  ops build               regenerate every derived file
  ops check               run every mechanical rule right now
  ops origin              누가 냈나 — 항마다 출처를 세고 사람의 판정을 받는다
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import core  # noqa: E402


def _csv(v: str | None) -> list[str]:
    return [x.strip() for x in (v or "").split(",") if x.strip()]


# ------------------------------------------------------------------ ctx ----

def cmd_ctx(a) -> int:
    if a.what == "card":
        print(core.session_card("manual"))
        return 0
    entries = core.log_read(months=a.months)
    if a.kind:
        entries = [e for e in entries if e.get("kind") in _csv(a.kind)]
    if a.grep:
        g = a.grep.lower()
        entries = [e for e in entries
                   if g in json.dumps(e, ensure_ascii=False).lower()]
    if a.ref:
        entries = [e for e in entries if any(a.ref in r for r in e.get("refs", []))]
    entries = entries[-a.n:]
    if a.json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
        return 0
    if not entries:
        print("(해당 로그 없음)")
        return 0
    for e in entries:
        print(f"{e['ts'][:16]}  {e['kind']:<8} {e['title']}")
        if e.get("body"):
            for ln in e["body"].splitlines():
                print(f"                          {ln}")
        if e.get("refs"):
            print("                          ↳ " + ", ".join(e["refs"]))
    return 0


# ----------------------------------------------------------------- find ----

def cmd_find(a) -> int:
    want_labels, hits = set(_csv(a.label)), []
    for art in core.iter_artifacts():
        if a.kind and art.kind not in _csv(a.kind):
            continue
        if want_labels and not want_labels.issubset(set(art.labels)):
            continue
        if a.id and a.id not in art.id:
            continue
        if a.text:
            hay = " ".join([art.title, str(art.meta.get("summary", "")),
                            art.body or ""]).lower()
            if a.text.lower() not in hay:
                continue
        hits.append(art)
    if a.json:
        print(json.dumps([{"id": h.id, "path": core.rel(h.path), "kind": h.kind,
                           "labels": h.labels, "title": h.title} for h in hits],
                         ensure_ascii=False, indent=2))
        return 0
    for h in hits:
        print(f"{h.id:<20} {h.kind:<10} {core.rel(h.path):<44} "
              f"[{','.join(h.labels)}] {h.title}")
    print(f"— {len(hits)} hit(s)", file=sys.stderr)
    return 0


# ------------------------------------------------------------------ new ----

def _pin(parent_ids: list[str]) -> list[dict]:
    arts = core.artifact_map()
    out = []
    for pid in parent_ids:
        if pid not in arts:
            raise SystemExit(f"error: unknown source id '{pid}' "
                             f"(try: ops find --id {pid})")
        out.append({"id": pid, "hash": arts[pid].hash})
    return out


def cmd_new(a) -> int:
    if a.kind not in core.kinds():
        raise SystemExit(f"error: kind must be one of {list(core.kinds())}")
    path = Path(a.path)
    if not path.is_absolute():
        path = core.ROOT / path
    if path.exists() and not a.force:
        raise SystemExit(f"error: {core.rel(path)} exists (use --force to re-header)")
    meta = {
        "id": core.new_id(a.kind, a.title),
        "kind": a.kind,
        "title": a.title,
        "labels": _csv(a.label),
        "summary": (a.summary or "")[:core.limits()["summary_chars"]],
        "status": "active",
        "created": core.today(),
        "updated": core.today(),
    }
    parents = _csv(a.source)
    if parents:
        meta["derives_from"] = _pin(parents)
    body = a.body if a.body is not None else f"\n# {a.title}\n\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    if core.is_texty(path):
        path.write_text(core.join_frontmatter(meta, body), encoding="utf-8")
    else:
        path.touch()
        core.sidecar_for(path).write_text(
            __import__("yaml").safe_dump(meta, sort_keys=False, allow_unicode=True))
    print(f"created {core.rel(path)}  id={meta['id']}")
    core.build()
    return 0


def cmd_ingest(a) -> int:
    """Give metadata to everything under vault/ that has none. Unblocks HR-006."""
    targets = [Path(p) for p in a.paths] or [core.ROOT / r for r in core.ARTIFACT_ROOTS]
    kind_by_dir = {v["home"]: k for k, v in core.kinds().items()}
    made = 0
    for t in targets:
        t = t if t.is_absolute() else core.ROOT / t
        files = [t] if t.is_file() else sorted(p for p in t.rglob("*") if p.is_file())
        for p in files:
            if not core._needs_frontmatter(p):
                continue
            if any(part in core.SKIP_DIRS for part in p.parts):
                continue
            if core.read_meta(p)[0].get("id"):
                continue
            r = core.rel(p)
            kind = a.kind or next((k for d, k in kind_by_dir.items()
                                   if r.startswith(d + "/")), "raw")
            meta = {"id": core.new_id(kind, r), "kind": kind,
                    "title": p.stem.replace("-", " ").replace("_", " "),
                    "labels": _csv(a.label) or ["unsorted"],
                    "summary": "", "status": "draft",
                    "created": core.today(), "updated": core.today()}
            if core.is_texty(p):
                text = p.read_text(encoding="utf-8", errors="replace")
                p.write_text(core.join_frontmatter(meta, text), encoding="utf-8")
            else:
                core.write_meta(p, meta)
            print(f"labelled {r}  id={meta['id']}  kind={kind}")
            made += 1
    print(f"— {made} file(s) labelled", file=sys.stderr)
    if made:
        core.build()
    return 0


# ----------------------------------------------------------------- link ----

def cmd_link(a) -> int:
    g = core.build_graph()
    if a.op == "build":
        core.META.mkdir(exist_ok=True)
        (core.META / "graph.json").write_text(
            json.dumps(g, ensure_ascii=False, indent=2), encoding="utf-8")
        print(f"graph: {len(g['nodes'])} nodes, {len(g['edges'])} edges "
              f"-> {core.rel(core.META / 'graph.json')}")
        return 0

    if a.op == "check":
        stale = core.check_stale(g)
        for s in stale:
            print(f"STALE  {s.child_path:<44} ← {s.parent_path:<44} [{s.reason}]")
        print(f"— {len(stale)} stale of {len(g['edges'])} edges", file=sys.stderr)
        return 1 if stale else 0

    if a.op in ("why", "impact"):
        target = a.target
        if target not in g["nodes"]:
            target = core.id_for_path(target) or target
        if target not in g["nodes"]:
            raise SystemExit(f"error: no artifact for '{a.target}'")
        ids = (core.ancestors(target, g) if a.op == "why"
               else core.descendants(target, g))
        head = "출처(ancestors)" if a.op == "why" else "영향받는 것(descendants)"
        print(f"{target}  {g['nodes'][target]['title']}\n{head}:")
        for i in ids:
            n = g["nodes"].get(i, {})
            print(f"  {i:<20} {n.get('path','?'):<44} {n.get('title','')}")
        if not ids:
            print("  (없음)")
        return 0

    if a.op == "ack":
        changed = core.repin(a.target, _csv(a.source) or None)
        print(f"repinned {a.target}: " + (", ".join(changed) or "(nothing to do)"))
        core.build()
        return 0
    return 2


# ------------------------------------------------------------------ log ----

def cmd_log(a) -> int:
    if a.op == "add":
        e = core.log_add(a.kind, a.title, a.body or "", _csv(a.ref), _csv(a.label))
        print(f"logged [{e['kind']}] {e['title']}")
        core.build()                       # digest + STATE auto block follow
        return 0
    return cmd_ctx(argparse.Namespace(what="log", n=a.n, months=3, kind=None,
                                      grep=None, ref=None, json=False))


# ---------------------------------------------------------- build/check ----

def cmd_build(a) -> int:
    changed = core.build(write=not a.dry_run)
    for c in changed:
        print(("would update " if a.dry_run else "updated ") + c)
    if not changed:
        print("everything already current")
    return 1 if (a.dry_run and changed) else 0


def cmd_check(a) -> int:
    ctx = {"stage": "stop", "tool_name": None, "tool_input": {}, "cwd": str(core.ROOT)}
    bad = 0
    for stage in ("stop",):
        for v in core.evaluate(stage, ctx):
            bad += v.action == "deny"
            print(f"[{v.action.upper()}] {v.rule_id} {v.title}\n{v.detail}\n")
    print("OK — every mechanical rule passes" if not bad
          else f"{bad} blocking problem(s)", file=sys.stderr)
    return 1 if bad else 0


# ---------------------------------------------------------------- origin ----
# 누가 냈나 — 이 레포만의 것이 아니다. 다른 레포가 이 저장소를 서브모듈로 붙여서
# 같은 기계를 쓴다. 그래서 이 명령만은 core 를 쓰지 않고, 부르는 자리에서 위로
# 올라가며 .origin.yml 을 찾아 그 레포를 뿌리로 삼는다.

def _origin():
    """필요할 때만 불러온다. 이 모듈이 없어도 나머지 명령은 다 돌아야 한다 —
    위에서 불렀더니 파일 하나가 없다고 도구 전체가 죽었다 (2026-09-04)."""
    import origin
    return origin


def _origin_root() -> Path:
    origin = _origin()
    env = os.environ.get("ORIGIN_ROOT")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for d in [here, *here.parents]:
        if (d / origin.설정파일).is_file():
            return d
    raise SystemExit(
        f"{origin.설정파일} 을 여기서도 위에서도 못 찾았다.\n"
        f"어느 문서의 항을 셀지 정하는 파일이다. 레포 뿌리에 만든다.")


def cmd_origin(a) -> int:
    origin = _origin()
    뿌리 = _origin_root()

    if a.일감:
        파생 = (뿌리 / a.일감).resolve()
        if not 파생.is_file():
            raise SystemExit(f"그런 파일이 없다: {a.일감}")
        대상 = origin.일감_출처(뿌리, 파생)
        if not 대상:
            raise SystemExit(
                f"{a.일감} 의 사이드카에 출처가 없다.\n"
                f"이 길은 「이 파생물이 어느 출처의 어느 절에 기대는가」를 뒤집어 쓴다.\n"
                f"출처가 안 적힌 파일은 무엇을 판정해야 하는지 알 수 없다.")
        글, 담은 = origin.검토문서_만들기(뿌리, 대상, 제목=f"{a.일감} 을 쓰려면",
                                    몇개=a.몇개)
        곳 = " · ".join(f"{origin.상대(뿌리, f)}({','.join(map(str, 절)) or '전부'})"
                       for f, 절 in 대상)
        print(f"{origin.검토문서} 를 만들었다 — {a.일감} 이 기대는 곳: {곳}")
        print(f"  판정할 항 {담은}개. 적으신 뒤에 커밋해 주셔야 들어온다.")
        return 0

    if a.읽는다:
        바뀐, 튄것, 클로드것 = origin.검토문서_읽기(뿌리)
        print(f"항 {바뀐}개에 사람의 판정을 적었다.")
        if 클로드것:
            print(f"  받지 않은 줄 {클로드것}개 — 사람이 커밋한 줄이 아니다.")
        for t in 튄것:
            print(f"  못 읽은 줄: {t}")
        return 0

    if not a.문서:
        전체, 안됨, 표 = origin.세기(뿌리)
        print(f"문서 {len(origin.세는문서(뿌리))}개 · 항 {전체}개 · "
              f"판정이 없는 항 {안됨}개 ({안됨 * 100 // max(전체, 1)}%)\n")
        for n, t, f in 표:
            print(f"  {n:5d}/{t:<6d}  {f}")
        클로드것 = [x for p in origin.세는문서(뿌리) for x in origin.내가_적은_판정(p)]
        if 클로드것:
            print(f"\n  이 가운데 {len(클로드것)}개는 사람이 커밋한 판정이 아니라 "
                  f"클로드가 적은 것이다.")
        print("\n한 문서를 판정하려면: ops origin <파일> --검토")
        print("일감으로 좁히려면:   ops origin --일감 <파생물> --몇개 20")
        return 0

    p = (뿌리 / a.문서).resolve()
    if not p.is_file():
        raise SystemExit(f"그런 문서가 없다: {a.문서}")
    절 = [int(x) for x in a.절.split(",")] if a.절 else None
    if a.검토:
        _글, 담은 = origin.검토문서_만들기(
            뿌리, [(p, 절)], 제목=origin.상대(뿌리, p), 몇개=a.몇개, 찾기=a.찾기)
        좁힘 = []
        if 절:
            좁힘.append(f"{a.절}절")
        if a.찾기:
            좁힘.append(f"«{a.찾기}» 가 든 항")
        if a.몇개:
            좁힘.append(f"앞에서 {a.몇개}개")
        print(f"{origin.검토문서} 를 만들었다 — {origin.상대(뿌리, p)} "
              + (f"({' · '.join(좁힘)})" if 좁힘 else "")
              + f" 판정할 항 {담은}개.")
        print("  적으신 뒤에 커밋해 주셔야 들어온다.")
        return 0

    줄목록 = origin.현황(p)
    셈 = {}
    for *_x, v in 줄목록:
        셈[v] = 셈.get(v, 0) + 1
    print(f"{origin.상대(뿌리, p)} — 항 {len(줄목록)}개  "
          + " · ".join(f"{k} {v}" for k, v in sorted(셈.items())))
    for _이름, 절번호, 본문, 값 in 줄목록:
        if 절 and 절번호 not in 절:
            continue
        print(f"  [{값}] {절번호}절  {본문[:64]}")
    return 0


# ----------------------------------------------------------------- main ----

def main() -> int:
    ap = argparse.ArgumentParser(prog="ops", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("ctx", help="session card / log query")
    p.add_argument("what", nargs="?", default="log", choices=["card", "log"])
    p.add_argument("-n", type=int, default=15)
    p.add_argument("--months", type=int, default=3)
    p.add_argument("--kind"); p.add_argument("--grep"); p.add_argument("--ref")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ctx)

    p = sub.add_parser("find", help="locate artifacts by label/kind/text")
    p.add_argument("--label"); p.add_argument("--kind"); p.add_argument("--text")
    p.add_argument("--id"); p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_find)

    p = sub.add_parser("new", help="create an artifact with metadata + provenance")
    p.add_argument("kind"); p.add_argument("path")
    p.add_argument("--title", required=True)
    p.add_argument("--label"); p.add_argument("--summary")
    p.add_argument("--source", help="comma-separated ids this is DERIVED FROM")
    p.add_argument("--body"); p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("ingest", help="label existing files that have no metadata")
    p.add_argument("paths", nargs="*")
    p.add_argument("--label"); p.add_argument("--kind")
    p.set_defaults(fn=cmd_ingest)

    p = sub.add_parser("link", help="derivation graph")
    p.add_argument("op", choices=["build", "check", "why", "impact", "ack"])
    p.add_argument("target", nargs="?")
    p.add_argument("--source")
    p.set_defaults(fn=cmd_link)

    p = sub.add_parser("log", help="append to / read the machine log")
    p.add_argument("op", choices=["add", "list"])
    p.add_argument("--kind", default="work", choices=list(core.LOG_KINDS))
    p.add_argument("--title", default=""); p.add_argument("--body")
    p.add_argument("--ref"); p.add_argument("--label")
    p.add_argument("-n", type=int, default=15)
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("build", help="regenerate every derived file")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("check", help="run every mechanical rule now")
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("origin", help="누가 냈나 — 문서의 항마다 출처를 세고 판정을 받는다")
    p.add_argument("문서", nargs="?", help="비우면 레포 전체의 현황을 센다")
    p.add_argument("--검토", action="store_true", help="사람이 채울 문서를 만든다")
    p.add_argument("--읽는다", action="store_true", help="사람이 채워 커밋한 문서를 읽는다")
    p.add_argument("--일감", metavar="파생물", help="그 파생물이 기대는 출처의 절만 낸다")
    p.add_argument("--절", metavar="1,3,5", help="그 절의 항만 낸다")
    p.add_argument("--찾기", metavar="말", help="그 말이 든 항만 낸다")
    p.add_argument("--몇개", type=int, metavar="N", help="앞에서 N개만 담는다")
    p.set_defaults(fn=cmd_origin)

    a = ap.parse_args()
    if a.cmd == "log" and a.op == "add" and not a.title:
        ap.error("log add needs --title")
    if a.cmd == "link" and a.op in ("why", "impact", "ack") and not a.target:
        ap.error(f"link {a.op} needs a target (id or path)")
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
